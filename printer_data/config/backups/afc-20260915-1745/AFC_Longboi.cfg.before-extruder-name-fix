[include mcu/AFC_longboi_mcu.cfg]

[mcu longboi]
canbus_uuid: 8a17d83bc5e7

[AFC_BoxTurtle longboi]
hub: longboi
extruder: extruder3
enable_assist: True        # Setting to True enables espooler assist while printing
enable_kick_start: True    # Setting to True enables full speed espoolers for kick_start_time(0.070 ms default) amount
buffer: longboi           # If not defined below from the install script, uncomment and add buffer name if using a buffer
long_moves_speed: 250 
long_moves_accel: 250

[temperature_sensor longboi]
sensor_type: temperature_mcu
sensor_mcu: longboi

[AFC_stepper lane7]
unit: longboi:1
step_pin: longboi:M1_STEP
dir_pin: !longboi:M1_DIR
enable_pin: !longboi:M1_EN
microsteps: 16
rotation_distance: 7.16
dist_hub: 148.92 
park_dist: 10
led_index: AFC_Indicator1:1, AFC_Indicator5:41-48
afc_motor_rwd: longboi:MOT1_RWD
afc_motor_fwd: longboi:MOT1_FWD
afc_motor_enb: longboi:MOT1_EN
rwd_speed_multiplier: 0.5
fwd_speed_multiplier: 0.5
pwm: True
hardware_pwm: True
prep: ^!longboi:TRG1
load: ^longboi:EXT1

[tmc2209 AFC_stepper lane7]
uart_pin: longboi:M1_UART
uart_address: 0
run_current: 0.8
sense_resistor: 0.110

[AFC_stepper lane8]
unit: longboi:2
step_pin: longboi:M2_STEP
dir_pin: longboi:M2_DIR
enable_pin: !longboi:M2_EN
microsteps: 16
rotation_distance: 7.16
dist_hub: 89.23 
park_dist: 10
led_index: AFC_Indicator2:1, AFC_Indicator5:33-38
afc_motor_rwd: longboi:MOT2_RWD
afc_motor_fwd: longboi:MOT2_FWD
afc_motor_enb: longboi:MOT2_EN
rwd_speed_multiplier: 0.5
fwd_speed_multiplier: 0.5
pwm: True
hardware_pwm: True
prep: ^!longboi:TRG2
load: ^longboi:EXT2

[tmc2209 AFC_stepper lane8]
uart_pin: longboi:M2_UART
uart_address: 0
run_current: 0.8
sense_resistor: 0.110

[AFC_stepper lane9]
unit: longboi:3
step_pin: longboi:M3_STEP
dir_pin: !longboi:M3_DIR
enable_pin: !longboi:M3_EN
microsteps: 16
rotation_distance: 7.16
dist_hub: 94.31 
park_dist: 10
led_index: AFC_Indicator3:1, AFC_Indicator5:17-23
afc_motor_rwd: longboi:MOT3_RWD
afc_motor_fwd: longboi:MOT3_FWD
afc_motor_enb: longboi:MOT3_EN
rwd_speed_multiplier: 0.5
fwd_speed_multiplier: 0.5
pwm: True
hardware_pwm: True
prep: ^!longboi:TRG3
load: ^longboi:EXT3

[tmc2209 AFC_stepper lane9]
uart_pin: longboi:M3_UART
uart_address: 0
run_current: 0.8
sense_resistor: 0.110

[AFC_stepper lane10]
unit: longboi:4
step_pin: longboi:M4_STEP
dir_pin: longboi:M4_DIR
enable_pin: !longboi:M4_EN
microsteps: 16
rotation_distance: 7.16
dist_hub: 157.38 
park_dist: 10
led_index: AFC_Indicator4:1, AFC_Indicator5:26-32
afc_motor_rwd: longboi:MOT4_RWD
afc_motor_fwd: longboi:MOT4_FWD
afc_motor_enb: longboi:MOT4_EN
rwd_speed_multiplier: 0.5
fwd_speed_multiplier: 0.5
pwm: True
